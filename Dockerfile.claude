# Claude Code variant image: installs the claude CLI on top of the official release image.
#
# Claude subscriptions (Pro / Max / Team) do not issue API keys; only the official Claude Code
# client can use subscription credentials, so the `claude_code` provider depends on an executable
# claude CLI inside the container. The release image is reused here to avoid reinstalling the
# Python dependencies.
FROM ghcr.io/harry0703/moneyprinterturbo:latest

# The CLI version is pinned so behavior does not drift when the image is rebuilt; bump the version here to upgrade.
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_MAJOR=22

# The claude CLI is distributed via npm and the release image has no Node.js, so the NodeSource repository is set up first.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get purge -y gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    claude --version
